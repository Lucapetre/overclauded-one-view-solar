{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/canonical_measurement.schema.json",
  "title": "Canonical measurement observation (SYNTHETIC DEMONSTRATION)",
  "description": "One measurement-level observation as exported to canonical_measurements.csv.gz / the canonical_observations SQLite view. Values in this demo are synthetic; normalisation does not turn them into measured household data.",
  "type": "object",
  "required": ["obs_id", "provider", "provider_profile_id", "provider_profile_version", "mapping_version", "endpoint_key",
               "account_id", "site_id", "site_key", "entity_scope", "raw_record_id", "payload_hash", "source_path",
               "source_time_role", "capture_time_utc", "received_at_utc", "effective_time_utc", "effective_time_basis",
               "metric_name", "canonical_unit", "metric_kind", "value_origin", "availability_status",
               "requirement_class", "field_rule_id"],
  "properties": {
    "obs_id": {"type": ["integer", "string"]},
    "provider": {"type": "string"},
    "provider_profile_id": {"type": "string"},
    "provider_profile_version": {"type": "string"},
    "mapping_version": {"type": "string"},
    "endpoint_key": {"type": "string"},
    "profile_variant": {"type": ["string", "null"]},
    "account_id": {"type": "string", "description": "kept as string (leading zeros / large ids preserved)"},
    "site_id": {"type": "string"},
    "site_key": {"type": "string", "description": "provider|account|site"},
    "device_id": {"type": ["string", "null"], "description": "native device id as string; only unique within its site"},
    "device_key": {"type": ["string", "null"], "description": "provider|account|site|device"},
    "entity_scope": {"type": "string", "enum": ["site", "inverter", "battery", "meter"]},
    "channel": {"type": ["string", "null"], "description": "phase (L1..L3) or string (PV1..) qualifier"},
    "raw_record_id": {"type": "string"},
    "payload_hash": {"type": "string"},
    "source_path": {"type": "string"},
    "source_line": {"type": ["integer", "string", "null"]},
    "source_time_raw": {"type": ["string", "null"]},
    "source_time_role": {"type": "string", "description": "e.g. collect_time, local_measurement_time, response_time, server_current_time, capture_time"},
    "measurement_time_utc": {"type": ["string", "null"], "description": "only when the source provides a measurement time"},
    "response_time_utc": {"type": ["string", "null"]},
    "capture_time_utc": {"type": ["string", "null"]},
    "received_at_utc": {"type": ["string", "null"]},
    "effective_time_utc": {"type": "string", "description": "ordering/framing anchor; its basis is effective_time_basis"},
    "effective_time_basis": {"type": "string"},
    "metric_name": {"type": "string"},
    "original_value": {"type": ["string", "null"], "description": "JSON-encoded original value (signed originals kept)"},
    "original_unit": {"type": ["string", "null"]},
    "canonical_value": {"type": ["number", "string", "null"]},
    "canonical_text": {"type": ["string", "null"], "description": "raw operating-state code/text"},
    "canonical_unit": {"type": "string", "enum": ["kW", "kWh", "pct", "degC", "V", "A", "Hz", "none"]},
    "metric_kind": {"type": "string"},
    "boundary": {"type": ["string", "null"], "description": "AC / DC / phase / site-flow boundary"},
    "value_origin": {"type": "string", "enum": ["simulated_observation", "observation", "derived", "estimated"]},
    "availability_status": {"type": "string", "enum": ["available", "unsupported", "not_installed", "access_denied", "missing", "stale", "invalid"]},
    "quality_flags": {"type": ["string", "null"]},
    "is_conflicted": {"type": ["integer", "string"]},
    "assumption_basis": {"type": ["string", "null"]},
    "requirement_class": {"type": "string", "enum": ["integration_required", "vendor_response_required", "optional"]},
    "transform_log": {"type": ["string", "null"]},
    "field_rule_id": {"type": "string"},
    "record_status": {"type": ["string", "null"], "enum": ["accepted", "conflict_version", null]}
  },
  "additionalProperties": false
}
